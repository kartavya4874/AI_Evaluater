# Windows development: public HTTPS endpoint. DGX: http://localhost:8000/v1
VLLM_BASE_URL=https://dgx.geetauniversity.edu.in/v1
VLLM_MODEL=google/gemma-4-31B-it
VLLM_API_KEY=EMPTY
VLLM_TIMEOUT_SECONDS=600
# Connection and stalled upload-write timeout; response timeout is separate.
VLLM_CONNECT_TIMEOUT_SECONDS=60
VLLM_TOKENIZE_TIMEOUT_SECONDS=30
VLLM_REQUEST_ATTEMPTS=2
VLLM_RETRY_MIN_SECONDS=3
VLLM_RETRY_MAX_SECONDS=15
WORKER_RECOVERY_SECONDS=5
VLLM_MAX_MODEL_LEN=8192
# Truncated OCR/grading responses retry with larger budgets, up to this cap.
VLLM_MAX_OUTPUT_TOKENS=6000
# Optional exact token preflight; DGX can use http://localhost:8000/tokenize.
# Leave empty if your public proxy does not expose tokenization; vLLM still enforces context limits.
VLLM_TOKENIZE_URL=
MONGO_URI=mongodb://localhost:27017/
MONGO_DB_NAME=ai_examiner
MONGO_SERVER_SELECTION_TIMEOUT_MS=3000
MONGO_CONNECT_TIMEOUT_MS=5000
MONGO_SOCKET_TIMEOUT_MS=30000
MONGO_WAIT_QUEUE_TIMEOUT_MS=10000
APP_ENV=development
JWT_SECRET_KEY=replace-with-a-random-secret
ADMIN_EMAIL=admin@example.com
GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
FRONTEND_URL=http://localhost:3000
MAX_FILE_SIZE=1073741824

BATCH_PROCESSING_MAX_WORKERS=3

VLLM_MAX_CONCURRENT_REQUESTS=3

# Parallel independent questions per sheet (1 disables; global AI limit still applies).
QUESTION_GRADING_WORKERS=3

# Persisted run budget includes queue time; retries/restarts do not reset it.
EVALUATION_RUN_TIMEOUT_SECONDS=3600
EVALUATION_MAX_RETRIES=5
AI_JSON_REPAIR_ATTEMPTS=2
AI_TRUNCATION_ATTEMPTS=3
AI_INITIAL_OUTPUT_TOKENS=1500
# Pin these to the deployed artifacts; change them when replacing model/tokenizer.
VLLM_MODEL_REVISION=
VLLM_TOKENIZER_REVISION=
